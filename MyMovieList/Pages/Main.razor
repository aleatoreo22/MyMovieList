@using TheMovieDB

@page "/"

<div class="container" style="horiz-align: center">
    <InfiniteScroll ObserverTargetId="observerTarget" ObservableTargetReached="FetchItens">
        <div class="row row-cols-auto">
            @foreach (var item in _covers)
            {
                <div class="col-xl-2 ">
                    <Cover Id="@item.Id" Name="@item.Name"
                        ImageSource="@(TheMovieDB.Global.ImageSizeUrl.IMAGE_URL_600X900 + item.ImageSource)" />
                </div>
            }
            <label id="observerTarget">Loading...</label>
        </div>

    </InfiniteScroll>
</div>

@code {
    private readonly List<CoverModel> _covers = new();
    private int _page = 1;
    private readonly TMDBSharp.Client _client = new(Global.TMDBToken ?? "");

    private async void FetchItens()
    {
        var popularMovies = await _client.MovieLists.GetPopular(page: _page);

        var covers = popularMovies?.Results?.Select(movie =>
        new CoverModel()
        {
            ImageSource = movie.PosterPath,
            Name = movie.Title,
            Id = movie.Id.HasValue ? (int)movie.Id.Value : 0
        }) ?? Enumerable.Empty<CoverModel>();

        _covers.AddRange(covers);
        _page++;
    }

    protected override Task OnInitializedAsync()
    {
        FetchItens();
        return Task.CompletedTask;
    }
}